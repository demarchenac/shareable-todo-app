# ==============================================================================
# APP CONFIGURATION
# ==============================================================================
NODE_ENV="development"

# ==============================================================================
# CONVEX CONFIGURATION
# ==============================================================================
# Find your URL in the Convex Dashboard > Settings > URL & Deploy Key
## (https://dashboard.convex.dev/)
VITE_CONVEX_URL="https://your-deployment-name.convex.cloud"

# Only required for CI/CD or local CLI deployments.
# Get this from 'npx convex dev' or the Convex Dashboard.
CONVEX_DEPLOY_KEY="prod:..."

# ==============================================================================
# WORKOS / AUTHKIT CONFIGURATION
# ==============================================================================
# Get these from the WorkOS Dashboard (https://dashboard.workos.com)

# [SERVER] Secret Key: Required for token exchange and session management.
WORKOS_API_KEY="sk_test_..."

# [SERVER] A random 32+ character string used to encrypt the session cookie.
# Use 'openssl rand -base64 32' to generate one.
WORKOS_COOKIE_PASSWORD="at-least-32-characters-long-secret-key"

# [SERVER] Client ID: Public identifier for your AuthKit project.
WORKOS_CLIENT_ID="client_..."

# [SERVER] Where WorkOS sends the user after login. 
# Must be exactly matched in the WorkOS Dashboard > Redirect URIs.
WORKOS_REDIRECT_URI="http://localhost:3000/api/auth/callback"